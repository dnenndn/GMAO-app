# Copy this file to .env and fill in your real values. Never commit .env.

# Same SQL Server your GMAO desktop app points to (see page_loginn.bas_connextion
# in the decompiled source, or your DBA, for the real values).
DB_SERVER=192.168.1.10
DB_NAME=GMAO
DB_USER=gmao_mobile_readwrite
DB_PASSWORD=change_me
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# Small separate database for the mobile app's own data (pending BSM/BRM
# requests awaiting validation, push tokens, notification log). Create it with
# backend/sql/01_create_app_db.sql. The GMAO database above is not used for any
# of that. All of these are optional - by default the app database is called
# GMAO_APP on the same server and uses the same login as above.
APPDB_NAME=GMAO_APP
# APPDB_SERVER=
# APPDB_PORT=
# APPDB_USER=
# APPDB_PASSWORD=

# Secret used to sign mobile session tokens. Generate a long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# "Rester connecté" on the login screen: how long that session lasts (renewed while the app is used)
JWT_REMEMBER_EXPIRES_IN=90d

# Port the connector service listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your mobile app's
# domain, or * only while testing on your own network)
CORS_ORIGIN=*

# Path to the Firebase service account JSON key (for push notifications).
# See BUILD_APK.md "Setting up push notifications" for how to get this file.
# Leave blank to run without push notifications (everything else still works).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Diesel consumption alerts (backend/src/fuelAlerts.js) - all optional.
# FUEL_ALERT_RATIO=1.5
# FUEL_ALERT_ROLES=Administrateur,Responsable Méthode,Responsable Magasin
# FUEL_ALERT_ENABLED=true

# Daily digest alerts (paperwork expiry, stock under minimum, preventive due)
# DAILY_ALERTS_ENABLED=false
# PAPERWORK_ALERT_DAYS=15
# PAPERWORK_ALERT_ROLES=Administrateur,Responsable Méthode,Responsable Magasin
# STOCK_ALERT_ROLES=Administrateur,Responsable Méthode,Responsable Magasin,Responsable Achat
# PREVENTIVE_ALERT_ROLES=Administrateur,Responsable Méthode,Responsable Technique,Responsable Maintenance

# Achats > Synthèse: familles counted as LUBRIFIANT (comma separated, case-insensitive) and
# familles left out of "PIÈCES DE RECHANGE" (e.g. MATIERE PREMIERE). Gasoil = articles linked to engines' fuel.
# ACHAT_FAMILLES_LUBRIFIANT=LUBRIFIANT
# ACHAT_FAMILLES_HORS_PR=

# Owner(s) of the app: every right, and the only ones who manage users and rights (comma separated). Default: marwen.
# OWNER_LOGINS=marwen

# Strapping database ("feuillard", desktop app Gestion de Feuillard). Same SQL Server and login as GMAO by default;
# the login must have access to that database. The app never changes its structure.
# FEUILLARD_DB_NAME=feuillard
# FEUILLARD_DB_SERVER=
# FEUILLARD_DB_USER=
# FEUILLARD_DB_PASSWORD=
